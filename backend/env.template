# Copy this file to .env and update the values

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/city_watch_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Configuration
PORT=3000

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads/reports

# Admin Configuration
ADMIN_EMAIL=admin@citywatch.com
ADMIN_PASSWORD=admin123

# Email / SMTP configuration (used for verification and notification emails)
# Example (Gmail SMTP):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password-or-smtp-password
# EMAIL_FROM="City Watch <no-reply@yourdomain.com>"

# If using other providers (SendGrid, Mailgun, SES) use their SMTP settings.
